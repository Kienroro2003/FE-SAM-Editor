    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
